@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

:root {
    --background: #090c0b;
    --panel: #111715;
    --border: #29332d;
    --text: #f0f2ec;
    --muted: #8b978d;
    --accent: #c6f36a;
    --danger: #e16d5b;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: var(--background);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
}

button {
    font: inherit;
}

.screen {
    min-height: 100vh;
    width: 100%;
}

.hidden {
    display: none !important;
}

/* BRAND */

.brand {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 42px;
    font-weight: 800;
    letter-spacing: 3px;
}

.brand span,
.section-heading h1 span,
.loading-content h1 span {
    color: var(--accent);
}

.eyebrow {
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
}

/* LOADING SCREEN */

.loading-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 32px 7%;
    isolation: isolate;
}

.loading-background,
.loading-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
}

.loading-background {
    background:
        radial-gradient(ellipse at 70% 40%, #384638 0%, transparent 42%),
        linear-gradient(120deg, #171e19, #080b09 70%);
    animation: atmosphere 8s ease-in-out infinite alternate;
}

.loading-overlay {
    background:
        linear-gradient(90deg, rgba(5, 8, 6, 0.96), rgba(5, 8, 6, 0.35)),
        linear-gradient(0deg, #090c0b, transparent 30%);
}

.loading-header,
.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.classified,
.topbar-label,
.corner-label {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 2px;
}

.loading-content {
    width: min(650px, 100%);
    padding: 70px 0;
}

.loading-content h1,
.section-heading h1 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.98;
    letter-spacing: -1px;
    margin: 22px 0;
}

.loading-description {
    color: #a9b2aa;
    line-height: 1.8;
    font-size: 14px;
    max-width: 420px;
}

.loading-status {
    display: flex;
    justify-content: space-between;
    margin-top: 55px;
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

.progress-track {
    width: 100%;
    height: 4px;
    background: #29312b;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.2s linear;
    box-shadow: 0 0 14px rgba(198, 243, 106, 0.35);
}

.loading-footer {
    margin-top: 15px;
    color: #69766c;
    font-size: 9px;
    letter-spacing: 2px;
}

.corner-label {
    align-self: flex-end;
}

@keyframes atmosphere {
    from {
        transform: scale(1);
        filter: brightness(0.8);
    }

    to {
        transform: scale(1.06);
        filter: brightness(1.2);
    }
}

/* UPGRADE SCREEN */

.upgrade-screen {
    background:
        radial-gradient(ellipse at 90% 0%, #1a281d 0%, transparent 35%),
        var(--background);
    padding: 0 7%;
}

.topbar {
    min-height: 100px;
    border-bottom: 1px solid var(--border);
}

.player-level {
    border: 1px solid var(--border);
    padding: 12px 18px;
    font-size: 11px;
    letter-spacing: 1px;
}

.player-level span {
    color: var(--accent);
    font-weight: 700;
    margin-left: 8px;
}

.upgrade-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 65px 0;
}

.section-heading h1 {
    font-size: clamp(36px, 5vw, 58px);
    margin: 16px 0 10px;
}

.section-heading > p:last-child {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
}

.panel {
    background: linear-gradient(135deg, #141b16, #0e1310);
    border: 1px solid var(--border);
}

.player-progress {
    margin-top: 38px;
    padding: 26px;
}

.progress-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 22px;
}

.muted-label,
.card-category {
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 2px;
    font-weight: 700;
}

.progress-info h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 25px;
    margin-top: 8px;
}

.xp-display {
    font-size: 12px;
    white-space: nowrap;
}

.xp-display strong {
    color: var(--accent);
}

.xp-display span {
    color: var(--muted);
}

.xp-track {
    height: 5px;
}

.progress-hint {
    margin-top: 14px;
    font-size: 11px;
    line-height: 1.7;
    color: var(--muted);
}

.upgrade-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin: 45px 0 20px;
}

.upgrade-heading h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 25px;
    letter-spacing: 1px;
}

.upgrade-heading > span {
    font-size: 9px;
    letter-spacing: 1.5px;
    color: var(--muted);
}

.upgrade-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
}

.upgrade-card {
    min-height: 230px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 22px;
    transition: border-color 0.2s, transform 0.2s;
}

.upgrade-card:hover {
    border-color: #637a4a;
    transform: translateY(-3px);
}

.upgrade-icon {
    display: grid;
    place-items: center;
    width: 43px;
    height: 43px;
    border: 1px solid #526348;
    color: var(--accent);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 21px;
    margin-bottom: 22px;
}

.upgrade-details h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 24px;
    margin: 7px 0;
}

.upgrade-details > p:last-child {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
}

.status-tag {
    margin-top: auto;
    padding-top: 22px;
    font-size: 9px;
    letter-spacing: 1.5px;
    font-weight: 700;
}

.available {
    color: var(--accent);
}

.locked {
    color: var(--danger);
}

.upgrade-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 40px;
}

.upgrade-actions > p {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1.5px;
    line-height: 1.8;
}

.primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    padding: 17px 24px;
    border: none;
    background: var(--accent);
    color: #10160b;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
}

.primary-button:hover {
    background: #d9ff94;
    transform: translateY(-2px);
}

.primary-button span {
    font-size: 18px;
}

.page-footer {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 25px 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1.5px;
}

/* MOBILE RESPONSIVENESS */

@media (max-width: 700px) {
    .loading-screen {
        padding: 25px 6%;
    }

    .classified {
        max-width: 130px;
        text-align: right;
        line-height: 1.8;
    }

    .upgrade-screen {
        padding: 0 5%;
    }

    .topbar {
        min-height: 80px;
    }

    .brand {
        font-size: 34px;
    }

    .topbar-label {
        display: none;
    }

    .upgrade-container {
        padding: 45px 0;
    }

    .upgrade-grid {
        grid-template-columns: 1fr;
    }

    .upgrade-card {
        min-height: 200px;
    }

    .progress-info {
        align-items: flex-start;
        flex-direction: column;
    }

    .upgrade-actions {
        align-items: stretch;
        flex-direction: column;
    }

    .primary-button {
        width: 100%;
    }

    .page-footer {
        flex-direction: column;
        line-height: 1.8;
    }
}
/* UPGRADE SCREEN COUNTDOWN */

.upgrade-loading {
    max-width: 1100px;
    margin: 0 auto 45px;
    padding: 20px;
    border: 1px solid var(--border);
    background: rgba(17, 23, 21, 0.8);
}

.upgrade-loading-info {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 12px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

.upgrade-loading > p {
    margin-top: 12px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
}

/* DASHBOARD */

.dashboard-screen {
    min-height: 100vh;
    padding: 0 7%;
    background:
        radial-gradient(ellipse at 80% 10%, #1a281d 0%, transparent 35%),
        var(--background);
}

.dashboard-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 55px 0;
}

.dashboard-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 350px;
    margin-top: 35px;
    overflow: hidden;
}

.hero-content {
    padding: 35px;
    align-self: center;
}

.hero-content h2 {
    margin: 20px 0;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(38px, 5vw, 62px);
    line-height: 0.95;
}

.hero-content > p:not(.eyebrow) {
    max-width: 370px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.9;
    margin-bottom: 25px;
}

.hero-visual {
    display: grid;
    place-items: center;
    min-height: 300px;
    background:
        radial-gradient(ellipse at center, #354832, transparent 65%),
        linear-gradient(135deg, #1b251c, #0b100d);
    border-left: 1px solid var(--border);
}

.operator-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 190px;
    height: 240px;
    border: 1px solid #526348;
    background: rgba(9, 12, 11, 0.55);
    transform: skewY(-2deg);
}

.operator-placeholder span {
    color: var(--accent);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 70px;
    font-weight: 800;
}

.operator-placeholder small {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 2px;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
}

.dashboard-card {
    min-height: 200px;
    padding: 22px;
    color: var(--text);
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition: border-color 0.2s, transform 0.2s;
}

.dashboard-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
}

.dashboard-number {
    display: block;
    margin-bottom: 25px;
    color: var(--accent);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 22px;
}

.dashboard-card h3 {
    margin-bottom: 10px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 23px;
}

.dashboard-card p {
    min-height: 38px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
}

.card-action {
    display: block;
    margin-top: 20px;
    color: var(--accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
}

.dashboard-message {
    min-height: 25px;
    margin-top: 20px;
    color: var(--accent);
    font-size: 12px;
    line-height: 1.7;
}

@media (max-width: 700px) {
    .dashboard-screen {
        padding: 0 5%;
    }

    .dashboard-container {
        padding: 40px 0;
    }

    .dashboard-hero {
        grid-template-columns: 1fr;
    }

    .hero-content {
        padding: 25px;
    }

    .hero-visual {
        min-height: 230px;
        border-left: none;
        border-top: 1px solid var(--border);
    }

    .operator-placeholder {
        height: 180px;
        width: 150px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

/* OPERATOR SELECTION */

#operator-screen {
    min-height: 100vh;
    padding: 0 7%;
    background:
        radial-gradient(ellipse at 80% 30%, #263b28, transparent 45%),
        var(--background);
}

.secondary-button {
    padding: 10px 15px;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
    cursor: pointer;
}

.operator-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 35px 0 20px;
}

.operator-preview {
    min-height: 400px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: radial-gradient(ellipse, #293c2b, #101511);
}

.operator-figure {
    display: grid;
    place-items: center;
    width: 180px;
    height: 220px;
    margin-bottom: 25px;
    border: 1px solid var(--accent);
    background: linear-gradient(145deg, #354b36, #111713);
    color: var(--accent);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 90px;
    font-weight: 800;
}

.operator-preview h2 {
    margin: 10px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 36px;
}

.operator-preview > p:not(.eyebrow) {
    color: var(--muted);
    font-size: 12px;
}

.operator-status {
    margin-top: 18px;
}

.operator-status span {
    color: var(--accent);
    font-weight: bold;
}

.operator-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.operator-card {
    display: flex;
    align-items: center;
    gap: 15px;
    width: 100%;
    min-height: 85px;
    padding: 15px;
    color: var(--text);
    text-align: left;
    background: rgba(17, 23, 21, 0.8);
    border: 1px solid var(--border);
    cursor: pointer;
}

.operator-card.selected {
    border-color: var(--accent);
    background: #202c21;
}

.operator-card.locked {
    opacity: 0.7;
}

.operator-number {
    color: var(--accent);
    font-size: 25px;
    font-weight: bold;
}

.operator-card strong,
.operator-card small {
    display: block;
}

.operator-card small {
    margin-top: 6px;
    color: var(--muted);
    font-size: 9px;
}

.operator-lock {
    margin-left: auto;
    color: var(--accent);
    font-size: 10px;
    font-weight: bold;
}

.operator-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px;
}

.operator-bottom h2 {
    margin-top: 8px;
}

@media (max-width: 700px) {
    #operator-screen {
        padding: 0 5%;
    }

    .operator-layout {
        grid-template-columns: 1fr;
    }

    .operator-preview {
        min-height: 300px;
    }

    .operator-figure {
        width: 130px;
        height: 150px;
        font-size: 65px;
    }

    .operator-bottom {
        align-items: flex-start;
        flex-direction: column;
    }
}


/* EQUIPMENT AND DEPLOYMENT SCREENS */
.equipment-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 30px 0;
}

.equipment-panel {
    padding: 25px;
    min-width: 0;
}

.equipment-panel h2,
.deployment-card h2 {
    margin: 12px 0;
    color: var(--text);
}

.equipment-select {
    width: 100%;
    margin-top: 18px;
    padding: 12px;
    color: var(--text);
    background: #151a18;
    border: 1px solid var(--border);
    border-radius: 4px;
}

.deployment-content {
    width: min(900px, 86%);
    margin: 60px auto;
    text-align: center;
}

.deployment-content h1 {
    margin: 12px 0 30px;
}

.deployment-card {
    max-width: 650px;
    margin: 0 auto;
    padding: 35px;
}

.deployment-figure {
    display: grid;
    place-items: center;
    width: 150px;
    height: 180px;
    margin: 0 auto 25px;
    border: 1px solid var(--border);
    background: linear-gradient(145deg, #29362e, #111512);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 64px;
    font-weight: 800;
}

#begin-game {
    margin-top: 20px;
}

@media (max-width: 768px) {
    .equipment-grid {
        grid-template-columns: 1fr;
    }

    .deployment-card {
        padding: 22px;
    }
}


/* PVT 3D BATTLEFIELD */
#gameplay-screen { padding: 0; min-height: 100vh; background: #101511; }
#battlefield {
    position: relative; width: 100%; height: 100vh; min-height: 500px;
    overflow: hidden; background: #263328; color: #f1f4ed;
    font-family: Arial, sans-serif;
}
#game-mount { position: absolute; inset: 0; }
#game-mount canvas { display: block; width: 100%; height: 100%; }
.battle-top {
    position: absolute; z-index: 3; top: 0; left: 0; right: 0;
    display: flex; justify-content: space-between; align-items: center;
    gap: 15px; padding: 18px 25px;
    background: linear-gradient(#090d0be8, #090d0b00);
    pointer-events: none;
}
.battle-brand { font-weight: 900; letter-spacing: 2px; font-size: 22px; }
.battle-brand > span { color: #c8a85b; }
.battle-brand small { display: block; margin-top: 4px; font-size: 10px; letter-spacing: 3px; }
.battle-stats { display: flex; flex-wrap: wrap; gap: 18px; font-size: 11px; }
.battle-stats strong { display: block; margin-top: 5px; font-size: 21px; color: #d5bc77; }
.battle-crosshair {
    position: absolute; z-index: 2; top: 50%; left: 50%;
    transform: translate(-50%, -50%); font-size: 25px;
    text-shadow: 0 0 5px #000; pointer-events: none;
}
.battle-instructions {
    position: absolute; z-index: 3; bottom: 20px; left: 20px;
    display: flex; flex-wrap: wrap; gap: 8px 15px;
    padding: 12px 15px; background: #080b09c9; font-size: 10px;
    letter-spacing: 1px; pointer-events: none;
}
.battle-instructions strong { color: #e2c779; }
#game-notice {
    position: absolute; z-index: 3; bottom: 25px; right: 20px;
    max-width: 45%; padding: 12px; background: #080b09c9;
    font-size: 11px; letter-spacing: 1px; text-align: right;
    pointer-events: none;
}
#game-over-panel {
    position: absolute; z-index: 5; inset: 0; display: flex;
    flex-direction: column; justify-content: center; align-items: center;
    gap: 15px; padding: 20px; text-align: center;
    background: #080b09e8;
}
#game-over-panel.hidden { display: none !important; }
#game-over-panel h1 { font-size: clamp(28px, 5vw, 55px); }
#game-over-panel p { line-height: 1.7; }
#game-over-panel .secondary-button { margin-top: 4px; }
@media(max-width: 600px) {
    .battle-top { padding: 12px; align-items: flex-start; }
    .battle-stats { gap: 9px; }
    .battle-stats strong { font-size: 16px; }
    .battle-instructions { left: 8px; right: 8px; bottom: 8px; gap: 7px; }
    #game-notice { display: none; }
}

/* PVT operator portrait images */
.operator-figure {
    width: 100%;
    max-width: 300px;
    height: 320px;
    overflow: hidden;
    padding: 0;
    background: #101511;
}

.operator-figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
}

.operator-card {
    overflow: hidden;
    transition: border-color 0.2s ease, background 0.2s ease;
}

.operator-card:hover {
    border-color: var(--accent);
}

.operator-card.selected {
    border-width: 2px;
    box-shadow: 0 0 15px rgba(100, 255, 120, 0.12);
}

@media (max-width: 700px) {
    .operator-figure {
        max-width: 240px;
        height: 260px;
    }
}

.operator-card-image {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    object-fit: cover;
    object-position: center top;
    border: 1px solid var(--border);
    background: #101511;
}

.operator-card.selected .operator-card-image {
    border-color: var(--accent);
}

@media (max-width: 480px) {
    .operator-card-image {
        width: 48px;
        height: 58px;
    }
}
